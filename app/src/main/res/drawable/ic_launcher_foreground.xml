<!--
  Точная векторная трассировка официального лого сайта (assets/icon-512.png).
  Геометрия получена измерением реальных пикселей PNG (numpy/scipy connected-
  components на 512x512 оригинале), а не нарисована на глаз:
    — центр рисунка: (255.5, 256.0) из 512 → (54, 54) в viewport 108
    — кольцо: радиус 94.9–140.1px (средний 117.5, толщина 45.2px) → радиус 24.8,
      толщина 9.5 в viewport 108; разрыв в дугах 59°–168° (низ чуть левее центра)
    — точка в центре: радиус 48.5px → 10.2 в viewport 108, тот же центр, что и у кольца
  Всё вписывается в safe zone адаптивной иконки (центральный круг ⌀ 66dp из 108dp).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Разомкнутое кольцо -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M29.74,59.16 A24.8,24.8 0 1 1 66.77,75.26" />
    <!-- Центральная точка -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,54 m-10.2,0 a10.2,10.2 0 1 1 20.4,0 a10.2,10.2 0 1 1 -20.4,0" />
</vector>
